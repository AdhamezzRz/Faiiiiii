{% comment %}
  Section contract.
  A large statement that lights up word by word as it scrolls through the viewport.
  @example
  <!-- Place under the hero -->
{% endcomment %}
{%- liquid
  assign s = section.settings
  assign words = s.text | strip | split: ' '
  assign accent_words = s.text_accent | strip | split: ' '
-%}
<section class="w26-statement w26-tone-{{ s.tone }}">
  <div class="w26-wrap">
    {%- if s.label != blank -%}
      <p class="w26-meta w26-statement__label" data-w26-reveal>{{ s.label | escape }}</p>
    {%- endif -%}
    <p class="w26-statement__text" data-w26-words>
      {%- for w in words -%}
        <span class="w26-w">{{ w | escape }}</span>{{ ' ' }}
      {%- endfor -%}
      {%- for w in accent_words -%}
        <span class="w26-w w26-w--accent">{{ w | escape }}</span>{{ ' ' }}
      {%- endfor -%}
    </p>
  </div>
</section>

{% schema %}
{
  "name": "W26 Statement",
  "tag": "div",
  "class": "w26-section",
  "settings": [
    { "type": "text", "id": "label", "label": "Small label", "default": "The collection" },
    { "type": "textarea", "id": "text", "label": "Statement", "default": "Winter is for layers. Six silhouettes, cut to be tied, buttoned, knotted and worn over everything you already own." },
    { "type": "textarea", "id": "text_accent", "label": "Closing line (accent colour)", "default": "And one flash of sky blue when the hood falls open." },
    {
      "type": "select",
      "id": "tone",
      "label": "Tone",
      "options": [
        { "value": "night", "label": "Night" },
        { "value": "bone", "label": "Bone" }
      ],
      "default": "night"
    }
  ],
  "presets": [{ "name": "W26 Statement" }]
}
{% endschema %}
